{
  "name": "acr-mobile-companion",
  "version": "0.1.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:active": "tsc --noEmit -p tsconfig.active.json",
    "verify:mobile": "node tests/mobile/verify.js && node tests/mobile/offlineWalkthrough.verify.js && node tests/mobile/resultPresentation.verify.js && node tests/p1p2/verify.js && node tests/version/verify.js && node tests/poster/verify.js && node tests/rtl/verify.js"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.29",
    "expo-localization": "~15.0.3",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
    "i18next": "^26.3.6",
    "react": "18.2.0",
    "react-i18next": "^17.0.11",
    "react-native": "^0.74.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  },
  "private": true
}
