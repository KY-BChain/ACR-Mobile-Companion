<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- REVIEW TEMPLATE ONLY. Prefer a per-user LaunchAgent. Do not install this
     system service before independent security review and owner Phase-B GO. -->
<dict>
    <key>Label</key>
    <string>com.cloudflare.cloudflared.acr-mobile-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cloudflared</string>
        <string>tunnel</string>
        <string>--config</string>
        <string>/Users/Kraken/.cloudflared/acr-mobile-review.yml</string>
        <string>run</string>
        <string>acr-mobile-review</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>UserName</key>
    <string>Kraken</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/Kraken/.cloudflared/logs/t4-out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Kraken/.cloudflared/logs/t4-err.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/Kraken/.cloudflared</string>
</dict>
</plist>
