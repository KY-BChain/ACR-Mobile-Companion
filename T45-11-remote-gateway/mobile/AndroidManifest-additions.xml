<!--
  AndroidManifest.xml additions for Build 45

  Add these attributes to the <application> tag:
    android:usesCleartextTraffic="false"
    android:networkSecurityConfig="@xml/network_security_config"

  The Build 44 cleartext exception must be removed.
-->

<!-- Example <application> tag for Build 45: -->
<application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:usesCleartextTraffic="false"
    android:networkSecurityConfig="@xml/network_security_config">

    <!-- Existing activities and services remain unchanged -->

</application>
